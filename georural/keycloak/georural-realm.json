{
  "realm": "georural",
  "enabled": true,
  "displayName": "GeoRural DataHub",
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Perfil ADMIN do GeoRural"
      },
      {
        "name": "GESTOR",
        "description": "Perfil GESTOR do GeoRural"
      },
      {
        "name": "OPERADOR",
        "description": "Perfil OPERADOR do GeoRural"
      },
      {
        "name": "ANALISTA",
        "description": "Perfil ANALISTA do GeoRural"
      },
      {
        "name": "AUDITOR",
        "description": "Perfil AUDITOR do GeoRural"
      }
    ]
  },
  "clients": [
    {
      "clientId": "georural-cli",
      "name": "GeoRural - tela de login",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "audiencia-georural-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "georural-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
