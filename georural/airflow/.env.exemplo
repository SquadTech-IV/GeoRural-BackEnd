# Copie para .env (e o .env NAO vai para o git).
# O ./subir.sh gera as duas chaves e esse arquivo sozinho; isto aqui e o modelo.

# ---------- obrigatorio ----------
# Chaves do Airflow. Sem elas os servicos nao sobem.
# Gere com:
#   docker run --rm apache/airflow:3.1.2 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -base64 32
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# ---------- onde esta a API do Spring ----------
# Visto de DENTRO do container. Deixe assim se a API roda na sua maquina.
# Se a API roda em outro container, use o nome do servico dela.
GEORURAL_API_BASE=http://host.docker.internal:8080

# So preencha quando a US#13 ligar a autenticacao. Vazio = sem cabecalho.
GEORURAL_API_TOKEN=

# ---------- opcional ----------
# Porta da interface do Airflow na sua maquina (8080 e da API do Spring).
AIRFLOW_PORTA=8081
AIRFLOW_VERSAO=3.1.2

# No Linux, ponha o seu id de usuario para os logs nao nascerem do root.
# No Windows e no Mac pode deixar em branco.
AIRFLOW_UID=

# Ajustes das DAGs (os padroes estao no README).
GEORURAL_MAX_RODADAS_PARALELAS=1
GEORURAL_RETRIES_ETAPA=0
GEORURAL_MAX_DISPAROS_POR_VARREDURA=50
GEORURAL_SITUACOES_DISPARAVEIS=RECEBIDO,APROVADO
# Tempo maximo de uma etapa, em segundos. 14400 = 4 horas.
GEORURAL_TIMEOUT_ETAPA_SEG=14400
